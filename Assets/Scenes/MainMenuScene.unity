  m_Text: "\u0412\u044B \u043F\u0440\u043E\u0441\u043D\u0451\u0442\u0435\u0441\u044C
    \u0432 \u0411\u0443\u043D\u043A\u0435\u0440\u0435 07 \u0438 \u043D\u0430\u0447\u043D\u0451\u0442\u0435
    \u043F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u043A\u0443 \u043C\u0430\u0448\u0438\u043D\u044B
    \u0441 \u043D\u0443\u043B\u044F.\n\n\u041A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u044B\u0435
    \u0442\u043E\u0447\u043A\u0438, \u0433\u0440\u0443\u0437 \u0438 \u043F\u0440\u043E\u0433\u0440\u0435\u0441\u0441
    \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0439 \u0438\u0433\u0440\u044B
    \u0431\u0443\u0434\u0443\u0442 \u0441\u0431\u0440\u043E\u0448\u0435\u043D\u044B.
    \u041D\u0430\u0441\u0442\u0440\u043E\u0439\u043A\u0438 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u0441\u044F."
