    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u041F\u043E\u0434\u0433\u043E\u0442\u043E\u0432\u044C\u0442\u0435 \u043C\u0430\u0448\u0438\u043D\u0443
    \u0432 \u0411\u0443\u043D\u043A\u0435\u0440\u0435 07 \u0438 \u0434\u043E\u0431\u0435\u0440\u0438\u0442\u0435\u0441\u044C
    \u0434\u043E \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439 \u0421\u0422\u041E.\n\n\u0418\u0449\u0438\u0442\u0435
    \u0442\u043E\u043F\u043B\u0438\u0432\u043E \u0438 \u0434\u0435\u0442\u0430\u043B\u0438,
    \u0440\u0435\u043C\u043E\u043D\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u0430\u0432\u0442\u043E\u043C\u043E\u0431\u0438\u043B\u044C
    \u0438 \u0443\u0445\u043E\u0434\u0438\u0442\u0435 \u043E\u0442 \u0431\u0443\u0440\u0438.
    \u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0435\u043D\u0438\u0435 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442
    \u043A \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C\u043D\u043E\u0439 \u0442\u043E\u0447\u043A\u0435
    \u043F\u0435\u0440\u0435\u0434 \u0432\u044B\u0435\u0437\u0434\u043E\u043C.\n\n\u042D\u043A\u0438\u043F\u0430\u0436
    \u2014 \u043E\u0442\u0434\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u043E\u0442\u043E\u0442\u0438\u043F
    \u0434\u043B\u044F \u0434\u0432\u043E\u0438\u0445 \u043F\u043E LAN / VPN: \u043E\u0431\u0449\u0430\u044F
    \u043C\u0430\u0448\u0438\u043D\u0430 \u0438 \u0441\u043C\u0435\u043D\u0430 \u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044F.\n\n\u0414\u0438\u043F\u043B\u043E\u043C\u043D\u044B\u0439
    \u043F\u0440\u043E\u0435\u043A\u0442 \u2022 \u0411\u0413\u0423\u0418\u0420"
