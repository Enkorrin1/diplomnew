    \u0443\u0441\u0438\u043B\u0435\u043D\u0438\u044F \u0432 \u043A\u0430\u0436\u0434\u043E\u043C
    \u0437\u0430\u0435\u0437\u0434\u0435.\n\n\u0414\u0438\u043F\u043B\u043E\u043C\u043D\u044B\u0439
