  m_Text: "\u0411\u0435\u0437\u044B\u043C\u044F\u043D\u043D\u044B\u0439 \u0432\u044B\u0436\u0438\u0432\u0448\u0438\u0439
    \u043F\u0440\u043E\u0431\u0438\u0432\u0430\u0435\u0442\u0441\u044F \u043A \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u043C\u0443
    \u0433\u043E\u0440\u043E\u0434\u0443.\n\n\u041F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u0435
    \u043C\u0430\u0440\u0448\u0440\u0443\u0442, \u0443\u043B\u0443\u0447\u0448\u0430\u0439\u0442\u0435
